#!/bin/sh
# Stands in for prettier, cspell, markdownlint-cli2 and mise in tests: logs the call to
# $FAKE_LOG, prints $FAKE_DIR/<name>.out if there is one, exits with <name>.code or 0.
name=$(basename "$0")
echo "$name $*" >> "$FAKE_LOG"
[ -f "$FAKE_DIR/$name.out" ] && cat "$FAKE_DIR/$name.out"
[ -f "$FAKE_DIR/$name.code" ] && exit "$(cat "$FAKE_DIR/$name.code")"
exit 0
